# ========== 后端（Spring Boot / Java） ==========
# 编译输出
/target/
/qinbaoba-server/target/
*/target/

# 日志文件
/logs/
/qinbaoba-server/logs/
*.log

# IDE 文件（IntelliJ IDEA）
.idea/
*.iml
*.iws
*.ipr
out/

# Maven 本地仓库（一般不忽略，除非特别指定）
# .m2/

# 应用配置文件（生产环境敏感信息）
# application-local.yml 等可根据需要添加
# qinbaoba-server/src/main/resources/application-local.yml

# ========== 前端（Vue / Node） ==========
# 依赖目录
node_modules/
/qinbaoba-h5/node_modules/
*/node_modules/

# 构建输出
/dist/
/qinbaoba-h5/dist/
*/dist/

# 本地环境文件
.env.local
.env.*.local

# 日志文件（前端开发可能产生）
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 打包缓存
/qinbaoba-h5/.cache/

# ========== 通用 ==========
# 操作系统生成文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器临时文件
*.swp
*.swo
*~
.editorconfig  # 如果希望统一团队风格，建议提交，这里不忽略
.vscode/       # 若团队使用 VSCode，可根据需要调整，这里先忽略

# 测试覆盖率报告
coverage/
.nyc_output/

# 压缩包、备份文件
*.zip
*.tar.gz
*.bak
*.orig

# 忽略 IDE 其它杂项
# External Libraries、Scratches and Consoles 等 IDE 内部目录不需要忽略（它们不会出现在文件系统中）